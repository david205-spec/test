<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="using:TestDesktop.Game"
        x:Class="TestDesktop.MainWindow"
        Title="Flappy Bird"
        Width="480" Height="640"
        MinWidth="360" MinHeight="480"
        Background="#203F4B">
  <game:GameView x:Name="GameSurface"
                 AutomationProperties.Name="Flappy Bird. Space or Up to flap, P to pause, R to restart." />
</Window>
